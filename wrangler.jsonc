{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "traverse-news",
  "main": "cloudflare-worker.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "traverse-news"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "TRAVERSE_DATA",
      "id": "665b4f9653594140826d5789bd4ac8f3",
      "preview_id": "1c73f5b6de2d420db8dd940d4e81484f"
    }
  ],
  "r2_buckets": [
    {
      "binding": "TRAVERSE_MEDIA",
      "bucket_name": "traverse-news-media"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://traverse-news.nickperez.workers.dev"
  },
  "triggers": {
    // Weekday pull 7:30am America/Detroit (EDT = UTC-4 → 11:30 UTC).
    // Morning letter preview (Nick only) Mon-Sat 8:00am America/Detroit
    // (EDT → 12:00 UTC). Live/public send is from Desk, not this cron.
    // Do not change these schedules without Nick's say-so.
    "crons": ["30 11 * * 1-5", "0 12 * * 1-6"]
  }
}

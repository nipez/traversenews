# Optional: Supabase (Desk auth + Postgres). Without these, the app uses local seed data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Desk password when Supabase is not configured (local / demo only)
DEV_DESK_PASSWORD=desk
DEV_DESK_EMAIL=nick@traverse.news

# Optional: AI assist for Desk originals (title/dek + source_urls only).
# Without this key, "Generate from source" skips and Nick writes the body.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
